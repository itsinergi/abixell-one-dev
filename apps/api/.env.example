# Environment: development | staging | production
NODE_ENV=development
PORT=4010

# Observability (Checkpoint 0F): optional override for the pino log
# level (fatal|error|warn|info|debug|trace). Unset = "debug" in
# development, "info" otherwise.
# LOG_LEVEL=info

# PostgreSQL connection (see infra/postgres/docker-compose.yml for local dev defaults)
DATABASE_URL="postgresql://abixell:abixell_dev_password@localhost:5442/abixell_one_dev?schema=public"

# JWT / session secrets (dev-only placeholder values — replace per environment)
# Refresh tokens are opaque random values stored as hashes; no refresh JWT secret is used.
JWT_ACCESS_SECRET="dev-only-change-me-access"

# HTTP hardening (Phase H): comma-separated frontend origins allowed to call the API.
# Keep client-specific domains in deployment config, never in source.
CORS_ORIGINS="http://localhost:5183,http://127.0.0.1:5183"
RATE_LIMIT_GLOBAL_MAX=1200
RATE_LIMIT_WINDOW="1 minute"
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW="1 minute"
# Per-route windows for profile updates and role switching. Both default to
# "1 minute" when unset; set them only to tune a specific deployment.
# PROFILE_UPDATE_RATE_LIMIT_WINDOW="1 minute"
# SWITCH_ROLE_RATE_LIMIT_WINDOW="1 minute"

# Reported by GET /health as the deployed release identifier. Optional.
# APPLICATION_RELEASE=""


# Client-IP / proxy trust (Fastify trustProxy). Secure default is false (ignore
# X-Forwarded-For/X-Forwarded-Proto). To honor forwarded headers from a
# deployment-controlled proxy, set TRUST_PROXY to an explicit allowlist:
#   TRUST_PROXY=10.0.0.5            # single trusted proxy IP
#   TRUST_PROXY=10.0.0.0/28,10.0.0.5 # multiple / CIDR mix
# Garbage or hop-count (TRUST_PROXY_HOPS) fails startup — keep unset unless
# the deployment topology is known. See
# infrastructure/security/http-hardening.ts:resolveTrustProxy().
# TRUST_PROXY=
# Platform-bootstrap-only shared secret, required to call POST /tenants
# (Tenant creation happens before any User/Role exists — see ADR-0004).
# Held only by Insting Tekno Sinergi engineering, never distributed to clients.
PLATFORM_BOOTSTRAP_KEY="dev-only-change-me-bootstrap"

# Durable outbound Integration worker (Phase H2 / PH-8). Defaults shown are
# safe starting values; tune per dedicated deployment after observing load.
INTEGRATION_OUTBOX_BATCH_SIZE=100
INTEGRATION_OUTBOX_MAX_ATTEMPTS=5
INTEGRATION_OUTBOX_RETRY_BASE_SECONDS=30
INTEGRATION_OUTBOX_CLAIM_TIMEOUT_SECONDS=300

# Shared document bytes are outside PostgreSQL and must be included in every
# backup set. Use a persistent mounted path in staging/production.
FILE_STORAGE_ROOT="./storage/documents"

# Set true only for a secondary API replica when exactly one separate process
# owns Scheduler execution. Leave false/unset for the designated worker.
SCHEDULER_DISABLED=false

# Catering pilot seed (npm run seed:pilot). Both passwords are required: the
# seed exits with code 2 when either is missing and never prints them.
# Generate a distinct strong value per environment; never commit a real one.
# Applies to the synthetic UNIT-CAT-PILOT-01 tenant only (FD-009-S1).
# PILOT_ADMIN_PASSWORD=""
# PILOT_USER_PASSWORD=""

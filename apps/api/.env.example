# Environment: development | staging | production
NODE_ENV=development
PORT=4000

# Observability (Checkpoint 0F): optional override for the pino log
# level (fatal|error|warn|info|debug|trace). Unset = "debug" in
# development, "info" otherwise.
# LOG_LEVEL=info

# PostgreSQL connection (see infra/postgres/docker-compose.yml for local dev defaults)
DATABASE_URL="postgresql://abixell:abixell_dev_password@localhost:5432/abixell_one?schema=public"

# JWT / session secrets (dev-only placeholder values — replace per environment)
JWT_ACCESS_SECRET="dev-only-change-me-access"
JWT_REFRESH_SECRET="dev-only-change-me-refresh"

# Platform-bootstrap-only shared secret, required to call POST /tenants
# (Tenant creation happens before any User/Role exists — see ADR-0004).
# Held only by Insting Tekno Sinergi engineering, never distributed to clients.
PLATFORM_BOOTSTRAP_KEY="dev-only-change-me-bootstrap"

{
  "name": "@abixell-one/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "cross-env SCHEDULER_DISABLED=true vitest run",
    "validate:isolated-db": "tsx scripts/validate-isolated-db.ts",
    "migrate": "node-pg-migrate up -m migrations --envPath .env",
    "migrate:production": "node-pg-migrate up -m migrations --envPath /dev/null",
    "migrate:down": "node-pg-migrate down -m migrations --envPath .env",
    "migrate:create": "node-pg-migrate create -m migrations",
    "seed": "tsx scripts/seed.ts",
    "seed:pilot": "tsx scripts/seed-pilot-catering.ts",
    "sync-permissions": "node scripts/sync-role-permissions.mjs",
    "cleanup:test-tenants": "tsx scripts/cleanup-test-tenants.ts",
    "fase1:pilot": "tsx scripts/run-pilot-fase1.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.1.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.1",
    "ajv": "^8.17.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^18.0.9",
    "fastify": "^5.0.0",
    "jsonwebtoken": "^9.0.2",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.12.0",
    "pino-pretty": "^11.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.5.4",
    "@types/pg": "^8.11.6",
    "cross-env": "^10.1.0",
    "eslint": "^9.9.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}

# Template for rendering staging/production .env. Never copy manually for
# staging — use render-env.mjs via the CD workflow. validate-env.mjs rejects
# placeholder values for staging/production.
#
# Variable sources:
#   [CD]      rendered by render-env.mjs from image digests + release
#   [SECRET]  GitHub Environment secret (STAGING_<NAME>)
#   [VAR]     GitHub Environment variable (STAGING_<NAME>)
#   [DEFAULT] safe default below; overridable by STAGING_<NAME>
#
# Wave 9.3 (Container & Secrets Hardening) — Hybrid split:
#   On the VPS, the deploy wrapper (abixell-staging-deploy-wrapper) splits the
#   validated env into two artifacts. This template is the single input the CD
#   workflow still renders; the split happens on the VPS after validation:
#
#     [SECRET] vars  → SOPS+age encrypted → /protected/staging.secrets.enc.env
#                      (POSTGRES_PASSWORD, JWT_ACCESS_SECRET,
#                       PLATFORM_BOOTSTRAP_KEY, DATABASE_URL)
#     [CONF]   vars  → plaintext           → /protected/staging.conf
#                      (all other variables, incl. operator-added TELEGRAM_*)
#
#   /protected/staging.env no longer persists after a Wave 9 deploy. The
#   secret names classified by the wrapper are also listed in the wrapper's
#   SECRET_NAMES array; keep that array in sync if a new secret is added here.
#   See CP_ENV_09_OPERATOR_CHECKLIST.md and runbook §9A for VPS setup.
DEPLOYMENT_ENVIRONMENT=staging
COMPOSE_PROJECT_NAME=abixell-one-environment-id

# [CD] Immutable references. Every production image, including PostgreSQL,
# must end with an immutable SHA-256 digest.
API_IMAGE=registry.example.invalid/abixell-one-api@sha256:replace-me
API_OPERATIONS_IMAGE=registry.example.invalid/abixell-one-api-operations@sha256:replace-me
WEB_IMAGE=registry.example.invalid/abixell-one-web@sha256:replace-me
POSTGRES_IMAGE=postgres:16.6-alpine3.20@sha256:replace-me

POSTGRES_USER=abixell
# Single-quote any .env value containing a literal $ so Compose preserves it.
POSTGRES_PASSWORD='replace-with-secret-manager-value'
POSTGRES_DB=abixell_one
DATABASE_URL='postgresql://abixell:replace-with-url-encoded-password@postgres:5432/abixell_one'

JWT_ACCESS_SECRET='replace-with-at-least-32-random-characters'
PLATFORM_BOOTSTRAP_KEY='replace-with-at-least-32-random-characters'
CORS_ORIGINS='https://replace-with-approved-origin.invalid'
LOG_LEVEL=info
RATE_LIMIT_GLOBAL_MAX=1200
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=1 minute

WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
SCHEDULER_DISABLED=false
INTEGRATION_OUTBOX_BATCH_SIZE=100
INTEGRATION_OUTBOX_MAX_ATTEMPTS=5
INTEGRATION_OUTBOX_RETRY_BASE_SECONDS=30
INTEGRATION_OUTBOX_CLAIM_TIMEOUT_SECONDS=300

# Operations profile backup output. The API document bytes remain in the
# deployment's named volume and are mounted read-only into the backup service.
BACKUP_ROOT=/srv/abixell-one/backups
# Wave 8 (PITR): WAL archiving directory. Postgres archives completed WAL
# segments here; they are synced offsite and used for point-in-time recovery.
WAL_ROOT=/srv/abixell-one/wal
# Wave 7 (Alerting, CP-ENV-07): Telegram credentials for alert delivery.
# Operator-supplied; leave commented to run probes in log-only mode. When set,
# the alert probes (abixell-alert-notify) send alerts via the Telegram API.
# Get a token from t.me/BotFather and a chat ID from the bot getUpdates API.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
APPLICATION_RELEASE=replace-with-release-id
# Optional: set BACKUP_ID only when an operator needs a safe explicit ID.
# Otherwise omit it and the script generates a UTC identifier.
